@app.post("/upload")
async def upload_files(files: Annotated[list[UploadFile], File(...)]):
    logger.info(
        "Multiple upload request received. Files: %s",
        len(files),
    )

    uploaded_documents = []
    failed_documents = []

    for file in files:
        original_filename = Path(file.filename or "uploaded_file.pdf").name

        logger.info(
            "Processing uploaded file: %s",
            original_filename,
        )

        try:
            # Create a unique physical filename.
            unique_id = uuid.uuid4().hex
            stored_filename = (
                f"{unique_id}_{original_filename}"
            )

            file_path = UPLOAD_FOLDER / stored_filename

            logger.info(
                "Saving physical file: %s",
                file_path,
            )

            with open(file_path, "wb") as buffer:
                shutil.copyfileobj(file.file, buffer)

            file_size = os.path.getsize(file_path)

            logger.info(
                "File saved successfully: %s (%s bytes)",
                original_filename,
                file_size,
            )

            # Extract text and create chunks.
            result = extract_text(str(file_path))

            text = result["text"]
            chunks = result["chunks"]

            logger.info(
                "Text extraction completed: %s | Characters: %s | Chunks: %s",
                original_filename,
                len(text),
                len(chunks),
            )

            if not chunks:
                raise ValueError(
                    "No text chunks could be extracted from the PDF."
                )

            # Create document metadata.
            document = document_manager.add_document(
                filename=original_filename,
                filesize=file_size,
                stored_filename=stored_filename,
            )

            # Add chunks to FAISS.
            faiss_chunks_added = vector_store.add_document(
                document_id=document["id"],
                filename=original_filename,
                chunks=chunks,
            )

            logger.info(
                "FAISS indexing completed for %s: %s chunks added",
                original_filename,
                faiss_chunks_added,
            )

            uploaded_documents.append(
                {
                    "document": document,
                    "characters": len(text),
                    "chunks": len(chunks),
                    "faiss_chunks_added": faiss_chunks_added,
                    "preview": text[:500],
                }
            )

        except Exception as exc:
            logger.exception(
                "Failed to process file: %s",
                original_filename,
            )

            # Remove physical file if processing failed.
            try:
                if file_path.exists():
                    file_path.unlink()
            except Exception:
                logger.exception(
                    "Failed to remove incomplete file: %s",
                    original_filename,
                )

            failed_documents.append(
                {
                    "filename": original_filename,
                    "error": str(exc),
                }
            )
    logger.info(
        "Multiple upload completed. Success: %s | Failed: %s",
        len(uploaded_documents),
        len(failed_documents),
    )

    return {
        "message": "Upload processing completed.",
        "total_files": len(files),
        "successful_files": len(uploaded_documents),
        "failed_files": len(failed_documents),
        "documents": uploaded_documents,
        "failures": failed_documents,
    }

@app.post("/ask")
async def ask_question(request: QuestionRequest):
    logger.info(
        "Received question: %s",
        request.question,
    )

    results = vector_store.search(
        query=request.question,
        top_k=5,
    )

    if not results:
        return {
            "question": request.question,
            "answer": "Please upload PDF first.",
            "sources": [],
        }

    logger.info(
        "FAISS returned %s relevant chunks for question: %s",
        len(results),
        request.question,
    )

    context_parts = []

    for result in results:
        context_parts.append(
            f"Document: {result['filename']}\n"
            f"Chunk: {result['chunk_index']}\n"
            f"Content:\n{result['text']}"
        )

    context = "\n\n---\n\n".join(context_parts)

    answer = ask_gemini(
        context,
        request.question,
    )

    sources = []

    for result in results:
        sources.append(
            {
                "filename": result["filename"],
                "chunk_index": result["chunk_index"],
                "document_id": result["document_id"],
                "score": round(result.get("final_score", 0.0), 6),
            }
        )

    sources = []

    for result in results:
        sources.append(
            {
                "document_id": result.get("document_id"),
                "filename": result.get("filename"),
                "chunk_index": result.get("chunk_index"),
                "text": result.get("text", ""),
                "score": result.get("final_score", 0.0),
            }
        )

    return {
        "question": request.question,
        "answer": answer,
        "sources": sources,
    }

