@app.middleware("http")
async def log_requests(request: Request, call_next):
    start_time = time.time()
    logger.info(
        "Request started: %s %s",
        request.method,
        request.url.path,
    )
    
    response = await call_next(request)
    duration_ms = (time.time() - start_time) * 1000

    logger.info(
        "Request completed: %s %s -> %s (%.2f ms)",
        request.method,
        request.url.path,
        response.status_code,
        duration_ms,
    )

    return response

