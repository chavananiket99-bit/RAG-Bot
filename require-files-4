import json
import logging
import threading
import re
import math
from pathlib import Path
from collections import Counter

import faiss
import numpy as np

from services.embedding_service import embedding_service

logger = logging.getLogger("uvicorn.error")

BASE_DIR = Path(__file__).resolve().parent.parent
INDEX_DIR = BASE_DIR / "indexes"

FAISS_INDEX_FILE = INDEX_DIR / "faiss.index"
METADATA_FILE = INDEX_DIR / "faiss_metadata.json"

import re

def calculate_signature_score(text):
    if not text:
        return 0.0
    normalized = re.sub(r"\s+", " ", text).strip().lower()
    # ---------------------------------------------------------
    # Find positions of important signature markers
    # ---------------------------------------------------------
    behalf_matches = list(
        re.finditer(
            r"\bfor\s+and\s+on\s+behalf\s+of\b",
            normalized
        )
    )
    signature_matches = list(
        re.finditer(
            r"\bsignature\s*:",
            normalized
        )
    )
    name_matches = list(
        re.finditer(
            r"\bname\s*:",
            normalized
        )
    )
    title_matches = list(
        re.finditer(
            r"\btitle\s*:",
            normalized
        )
    )
    # ---------------------------------------------------------
    # Actual signature block
    # ---------------------------------------------------------
    for behalf in behalf_matches:
        behalf_pos = behalf.start()
        nearby_signature = any(
            abs(m.start() - behalf_pos) <= 500
            for m in signature_matches
        )
        nearby_name = any(
            abs(m.start() - behalf_pos) <= 500
            for m in name_matches
        )
        nearby_title = any(
            abs(m.start() - behalf_pos) <= 500
            for m in title_matches
        )
        # Strongest evidence
        if nearby_signature and nearby_name:
            return 1.0
        if nearby_name and nearby_title:
            return 0.9
        if nearby_signature:
            return 0.75
        if nearby_name:
            return 0.7
    # ---------------------------------------------------------
    # Signed / delivered block
    # ---------------------------------------------------------
    if re.search(
        r"\bsigned\s+sealed\s+and\s+delivered\b",
        normalized
    ):
        if name_matches and signature_matches:
            return 0.95
        if name_matches:
            return 0.85
    # ---------------------------------------------------------
    # Authorized signatory
    # ---------------------------------------------------------
    if re.search(
        r"\bauthori[sz]ed\s+signatory\b",
        normalized
    ):
        if name_matches or signature_matches:
            return 0.85
        return 0.6
    # ---------------------------------------------------------
    # Signed by + name
    # ---------------------------------------------------------
    if re.search(r"\bsigned\s+by\b", normalized):
        if name_matches:
            return 0.8
        return 0.5
    # ---------------------------------------------------------
    # Electronic signature metadata
    # ---------------------------------------------------------
    if re.search(r"\besign\s+by\s+signdesk\b", normalized):
        if signature_matches:
            return 0.6
        return 0.3
    # ---------------------------------------------------------
    # Generic signature fields
    # ---------------------------------------------------------
    if signature_matches and name_matches:
        return 0.5
    if signature_matches:
        return 0.2
    return 0.0

class FAISSVectorStore:

    def __init__(self):
        INDEX_DIR.mkdir(parents=True, exist_ok=True)

        self.lock = threading.Lock()

        self.dimension = (
            embedding_service.model.get_embedding_dimension()
        )

        self.index = None
        self.metadata = {}
        self.next_vector_id = 1

        self._load()

    # ============================================================
    # FAISS LOAD
    # ============================================================

    def _load(self):
        """
        Load the FAISS index and metadata from disk.
        """

        if FAISS_INDEX_FILE.exists():

            logger.info(
                "Loading FAISS index from disk: %s",
                FAISS_INDEX_FILE
            )

            self.index = faiss.read_index(
                str(FAISS_INDEX_FILE)
            )

        else:

            logger.info(
                "Creating a new FAISS index. Dimension: %s",
                self.dimension
            )

            base_index = faiss.IndexFlatIP(
                self.dimension
            )

            self.index = faiss.IndexIDMap2(
                base_index
            )

        if METADATA_FILE.exists():

            try:

                with open(
                    METADATA_FILE,
                    "r",
                    encoding="utf-8"
                ) as file:

                    data = json.load(file)

                self.metadata = data.get(
                    "metadata",
                    {}
                )

                self.next_vector_id = data.get(
                    "next_vector_id",
                    1
                )

            except Exception as exc:

                logger.error(
                    "Failed to load FAISS metadata: %s",
                    exc
                )

                self.metadata = {}
                self.next_vector_id = 1

        logger.info(
            "FAISS vector count: %s",
            self.index.ntotal
        )

        logger.info(
            "FAISS metadata entries: %s",
            len(self.metadata)
        )

    # ============================================================
    # SAVE
    # ============================================================

    def _save(self):
        """
        Persist FAISS index and metadata to disk.
        """

        temp_index_file = (
            FAISS_INDEX_FILE.with_suffix(".tmp")
        )

        faiss.write_index(
            self.index,
            str(temp_index_file)
        )

        temp_index_file.replace(
            FAISS_INDEX_FILE
        )

        data = {
            "next_vector_id": self.next_vector_id,
            "metadata": self.metadata
        }

        temp_metadata_file = (
            METADATA_FILE.with_suffix(".tmp")
        )

        with open(
            temp_metadata_file,
            "w",
            encoding="utf-8"
        ) as file:

            json.dump(
                data,
                file,
                indent=2,
                ensure_ascii=False
            )

        temp_metadata_file.replace(
            METADATA_FILE
        )

    # ============================================================
    # ADD DOCUMENT
    # ============================================================

    def add_document(
        self,
        document_id,
        filename,
        chunks
    ):
        """
        Add a document's chunks to the FAISS index.
        """

        if not chunks:
            return 0

        cleaned_chunks = [
            chunk.strip()
            for chunk in chunks
            if chunk and chunk.strip()
        ]

        if not cleaned_chunks:
            return 0

        logger.info(
            "Creating embedding for document: %s",
            filename
        )

        embeddings = (
            embedding_service.embed_documents(
                cleaned_chunks
            )
        )

        vectors = np.asarray(
            embeddings,
            dtype="float32"
        )

        vector_ids = []
        metadata_entries = {}

        with self.lock:

            for index, chunk in enumerate(
                cleaned_chunks
            ):

                vector_id = self.next_vector_id
                self.next_vector_id += 1

                vector_ids.append(
                    vector_id
                )

                metadata_entries[
                    str(vector_id)
                ] = {
                    "document_id": document_id,
                    "filename": filename,
                    "chunk_index": index,
                    "text": chunk
                }

            ids = np.asarray(
                vector_ids,
                dtype="int64"
            )

            self.index.add_with_ids(
                vectors,
                ids
            )

            self.metadata.update(
                metadata_entries
            )

            self._save()

        logger.info(
            "Added %s chunks to FAISS for document %s",
            len(cleaned_chunks),
            document_id
        )

        logger.info(
            "Total vectors in FAISS: %s",
            self.index.ntotal
        )

        return len(cleaned_chunks)

    # ============================================================
    # TOKENIZER
    # ============================================================

    def _tokenize(self, text):
        """
        Simple tokenizer for lexical search.
        """

        if not text:
            return []

        return re.findall(
            r"\b[a-zA-Z0-9]+\b",
            text.lower()
        )

    # ============================================================
    # LEXICAL SEARCH
    # ============================================================

    def _lexical_search(
        self,
        query,
        top_k=15
    ):
        """
        Lightweight BM25-style lexical search.

        Useful for:
        - names
        - clause numbers
        - dates
        - exact terminology
        - agreement names
        """

        query_tokens = self._tokenize(
            query
        )

        if not query_tokens:
            return []

        documents = []

        for vector_id, metadata in self.metadata.items():

            tokens = self._tokenize(
                metadata.get("text", "")
            )

            if tokens:

                documents.append(
                    (
                        int(vector_id),
                        tokens
                    )
                )

        if not documents:
            return []

        total_documents = len(
            documents
        )

        document_frequency = Counter()

        for _, tokens in documents:

            for token in set(tokens):

                document_frequency[token] += 1

        average_length = (
            sum(
                len(tokens)
                for _, tokens in documents
            )
            / total_documents
        )

        k1 = 1.5
        b = 0.75

        query_term_counts = Counter(
            query_tokens
        )

        scored_documents = []

        for vector_id, tokens in documents:

            token_counts = Counter(
                tokens
            )

            document_length = len(
                tokens
            )

            score = 0.0

            for term, query_count in (
                query_term_counts.items()
            ):

                term_frequency = (
                    token_counts.get(
                        term,
                        0
                    )
                )

                if term_frequency == 0:
                    continue

                df = document_frequency.get(
                    term,
                    0
                )

                idf = math.log(
                    1
                    + (
                        total_documents
                        - df
                        + 0.5
                    )
                    / (
                        df
                        + 0.5
                    )
                )

                denominator = (
                    term_frequency
                    + k1
                    * (
                        1
                        - b
                        + b
                        * (
                            document_length
                            / average_length
                        )
                    )
                )

                term_score = (
                    idf
                    * (
                        (
                            term_frequency
                            * (k1 + 1)
                        )
                        / denominator
                    )
                )

                score += (
                    term_score
                    * query_count
                )

            if score > 0:

                metadata = self.metadata.get(
                    str(vector_id)
                )

                if metadata:

                    scored_documents.append(
                        {
                            "score": float(score),
                            "vector_id": vector_id,
                            "document_id": metadata[
                                "document_id"
                            ],
                            "filename": metadata[
                                "filename"
                            ],
                            "chunk_index": metadata[
                                "chunk_index"
                            ],
                            "text": metadata[
                                "text"
                            ]
                        }
                    )

        scored_documents.sort(
            key=lambda x: x["score"],
            reverse=True
        )

        return scored_documents[:top_k]

    # ============================================================
    # FAISS SEARCH
    # ============================================================

    def _semantic_search(
        self,
        query,
        top_k=15
    ):

        query_embedding = (
            embedding_service.embed_text(
                query
            )
        )

        query_vector = np.asarray(
            [query_embedding],
            dtype="float32"
        )

        scores, vector_ids = (
            self.index.search(
                query_vector,
                top_k
            )
        )

        results = []

        for score, vector_id in zip(
            scores[0],
            vector_ids[0]
        ):

            if vector_id == -1:
                continue

            metadata = self.metadata.get(
                str(int(vector_id))
            )

            if not metadata:
                continue

            results.append(
                {
                    "score": float(score),
                    "vector_id": int(vector_id),
                    "document_id": metadata[
                        "document_id"
                    ],
                    "filename": metadata[
                        "filename"
                    ],
                    "chunk_index": metadata[
                        "chunk_index"
                    ],
                    "text": metadata[
                        "text"
                    ]
                }
            )

        return results

    # ============================================================
    # DOCUMENT / INTENT BOOSTING
    # ============================================================
    def _normalize_text(self, text):
        if not text:
            return ""
        return re.sub(
            r"[^a-z0-9]+",
            " ",
            text.lower()
        ).strip()

    def _document_hint_score(self, query, filename):
        """
        Detect whether the query explicitly refers to
        a document/file name.
        """
        query_text = self._normalize_text(query)
        file_text = self._normalize_text(
            Path(filename).stem
        )

        if not query_text or not file_text:
            return 0.0
        query_tokens = set(
            query_text.split()
        )
        file_tokens = set(
            file_text.split()
        )
        if not file_tokens:
            return 0.0
        overlap = (
            query_tokens.intersection(
                file_tokens
            )
        )
        return (
            len(overlap)
            / len(file_tokens)
        )
    def _intent_score(self, query, text):
        """
        Boost chunks that match the intent of the question.
        """
        query_text = self._normalize_text(
            query
        )
        chunk_text = self._normalize_text(
            text
        )
        if not query_text or not chunk_text:
            return 0.0
        # --------------------------------------------------------
        # Signatory / signature questions
        # --------------------------------------------------------
        signatory_terms = [
            "signatory",
            "signatories",
            "signature",
            "signatures",
            "signed",
            "esign",
            "e sign",
            "authorized signatory",
            "authorised signatory",
            "witness whereof",
        ]
        if any(
            term in query_text
            for term in signatory_terms
        ):
            matching_terms = 0
            for term in signatory_terms:
                if term in chunk_text:
                    matching_terms += 1
            if matching_terms:
                return min(
                    1.0,
                    0.25
                    * matching_terms
                )
        return 0.0

    def _signature_score(self, query, text):
        """
        Detect chunks that are likely to contain
        actual agreement signatories.
        """
        query_text = self._normalize_text(query)
        chunk_text = self._normalize_text(text)
        if not query_text or not chunk_text:
            return 0.0
        signatory_query_terms = [
            "signatory",
            "signatories",
            "who signed",
            "signed by",
            "signature",
            "signatures",
        ]
        is_signature_question = any(
            term in query_text
            for term in signatory_query_terms
        )
        if not is_signature_question:
            return 0.0
        score = 0.0
        # --------------------------------------------------------
        # Strong signature indicators
        # --------------------------------------------------------
        signature_indicators = [
            "esign by signdesk",
            "electronic signature",
            "electronic signing",
            "signed",
            "signature",
            "signatory",
            "authorized signatory",
            "authorised signatory",
            "in witness whereof",
        ]
        indicator_count = sum(
            1
            for term in signature_indicators
            if term in chunk_text
        )
        score += min(
            0.60,
            indicator_count * 0.15
        )
        # --------------------------------------------------------
        # Person-name pattern
        #
        # OCR commonly produces:
        #
        # Rakesh Sen Rakesh Sen
        # Rampraveen Swaminathan
        #
        # We give a modest bonus to chunks containing
        # multiple capitalized-name-like patterns.
        # --------------------------------------------------------
        import re
        name_matches = re.findall(
            r"\b[A-Z][a-z]{2,}(?:\s+[A-Z][a-z]{2,})+\b",
            text
        )
        unique_names = set(
            name.strip()
            for name in name_matches
        )
        if len(unique_names) >= 2:
            score += 0.40
        elif len(unique_names) == 1:
            score += 0.20
        return min(
            1.0,
            score
        )

    # ============================================================
    # HYBRID SEARCH
    # ============================================================
    def search(
        self,
        query,
        top_k=8
    ):
        """
        Hybrid retrieval:
        1. FAISS semantic search
        2. Lexical BM25-style search
        3. Reciprocal Rank Fusion (RRF)
        4. Query-aware boosting
        """

        if not query or not query.strip():
            return []

        if self.index.ntotal == 0:
            return []

        # --------------------------------------------------------
        # 1. Retrieve candidates
        # --------------------------------------------------------
        semantic_results = self._semantic_search(
            query,
            top_k=15
        )

        lexical_results = self._lexical_search(
            query,
            top_k=15
        )

        # --------------------------------------------------------
        # 2. Reciprocal Rank Fusion
        # --------------------------------------------------------
        fusion_scores = {}
        result_lookup = {}
        rrf_k = 60

        # --------------------------------------------------------
        # Semantic results
        # --------------------------------------------------------
        for rank, result in enumerate(
            semantic_results,
            start=1
        ):
            vector_id = result["vector_id"]
            fusion_scores.setdefault(
                vector_id,
                0.0
            )

            fusion_scores[vector_id] += (
                1.0 / (rrf_k + rank)
            )

            # Keep semantic result as the
            # canonical result.
            result_lookup[vector_id] = dict(result)

            # Explicitly preserve semantic score.
            result_lookup[vector_id][
                "semantic_score"
            ] = float(
                result.get("score", 0.0)
            )

        # --------------------------------------------------------
        # Lexical results
        # --------------------------------------------------------
        for rank, result in enumerate(
            lexical_results,
            start=1
        ):
            vector_id = result["vector_id"]
            fusion_scores.setdefault(
                vector_id,
                0.0
            )
            fusion_scores[vector_id] += (
                1.0 / (rrf_k + rank)
            )

            # If this vector was not found by semantic
            # search, use the lexical result as the
            # fallback metadata/result.
            if vector_id not in result_lookup:
                result_lookup[vector_id] = dict(result)
                result_lookup[vector_id][
                    "semantic_score"
                ] = 0.0

            # Always keep lexical score separately.
            result_lookup[vector_id][
                "lexical_score"
            ] = float(
                result.get("score", 0.0)
            )

        # --------------------------------------------------------
        # 3. Build ranked candidates
        # --------------------------------------------------------
        ranked_results = []
        for vector_id, fusion_score in (
            fusion_scores.items()
        ):
            result = dict(
                result_lookup[vector_id]
            )
            result["fusion_score"] = float(
                fusion_score
            )

            # Make sure fields always exist.
            result.setdefault(
                "semantic_score",
                0.0
            )
            result.setdefault(
                "lexical_score",
                0.0
            )

            # ----------------------------------------------------
            # Query-aware signals
            # ----------------------------------------------------
            document_score = (
                self._document_hint_score(
                    query,
                    result["filename"]
                )
            )

            intent_score = (
                self._intent_score(
                    query,
                    result["text"]
                )
            )

            signature_score = (
                calculate_signature_score(
                    result["text"]
                )
            )

            result["document_score"] = float(
                document_score
            )
            result["intent_score"] = float(
                intent_score
            )
            result["signature_score"] = float(
                signature_score
            )

            # ----------------------------------------------------
            # Final score
            # ----------------------------------------------------
            result["final_score"] = (
                result["fusion_score"]
                + (
                    result["document_score"]
                    * 0.05
                )
                + (
                    result["intent_score"]
                    * 0.02
                )
                + (
                    result["signature_score"]
                    * 0.03
                )
            )
            ranked_results.append(
                result
            )

        # --------------------------------------------------------
        # 4. Sort
        # --------------------------------------------------------
        ranked_results.sort(
            key=lambda x: x["final_score"],
            reverse=True
        )

        # --------------------------------------------------------
        # 5. Return top K
        # --------------------------------------------------------
        final_results = ranked_results[:top_k]

        # --------------------------------------------------------
        # Logging
        # --------------------------------------------------------
        logger.info(
            "Hybrid search: semantic=%s lexical=%s final=%s",
            len(semantic_results),
            len(lexical_results),
            len(final_results)
        )

        for rank, result in enumerate(
            final_results,
            start=1
        ):
            logger.info(
                "RANK=%s FILE=%s CHUNK=%s "
                "FINAL=%.6f FUSION=%.6f "
                "SEMANTIC=%.6f LEXICAL=%.6f "
                "DOC=%.3f INTENT=%.3f SIGNATURE=%.3f",

                rank,
                result["filename"],
                result["chunk_index"],
                result["final_score"],
                result["fusion_score"],
                result["semantic_score"],
                result["lexical_score"],
                result["document_score"],
                result["intent_score"],
                result["signature_score"],
            )
        return final_results

    # ============================================================
    # DELETE DOCUMENT
    # ============================================================

    def delete_document(
        self,
        document_id
    ):

        vector_ids = []

        for vector_id, metadata in (
            self.metadata.items()
        ):

            if metadata.get(
                "document_id"
            ) == document_id:

                vector_ids.append(
                    int(vector_id)
                )

        if not vector_ids:

            logger.info(
                "No FAISS vectors found for document: %s",
                document_id
            )

            return 0

        with self.lock:

            ids = np.asarray(
                vector_ids,
                dtype="int64"
            )

            removed = (
                self.index.remove_ids(
                    ids
                )
            )

            for vector_id in vector_ids:

                self.metadata.pop(
                    str(vector_id),
                    None
                )

            self._save()

        logger.info(
            "Removed %s vectors for document: %s",
            removed,
            document_id
        )

        logger.info(
            "Total vectors in FAISS after deletion: %s",
            self.index.ntotal
        )

        return int(removed)

    # ============================================================
    # DOCUMENT VECTOR COUNT
    # ============================================================

    def get_document_vector_count(
        self,
        document_id
    ):

        count = 0

        for metadata in (
            self.metadata.values()
        ):

            if metadata.get(
                "document_id"
            ) == document_id:

                count += 1

        return count

    # ============================================================
    # TOTAL VECTOR COUNT
    # ============================================================

    def get_total_vector_count(self):

        return self.index.ntotal


vector_store = FAISSVectorStore()

