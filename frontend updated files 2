                <div className="h-px flex-1 bg-slate-200" />
              </div>
              <form onSubmit={handleSubmit} className="space-y-4">
                {/* Username */}
                <div>
                  <label
                    htmlFor="username"
                    className="mb-1.5 block text-xs font-semibold text-slate-700"
