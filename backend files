import logging
import threading
import uuid
from collections import defaultdict

logger = logging.getLogger("uvicorn.error")

class ConversationService:
    # ========================================================
    # INITIALIZATION
    # ========================================================
    def __init__(self):
        self.lock = threading.Lock()

        # ----------------------------------------------------
        # Structure:
        #
        # conversations[user_id][conversation_id]
        #
        # This ensures one user's conversation cannot be
        # accidentally used by another user.
        # ----------------------------------------------------
        self.conversations = defaultdict(dict)
        logger.info(
            "Conversation service initialized."
        )

    # ========================================================
    # CREATE CONVERSATION
    # ========================================================
    def create_conversation(
        self,
        user_id
    ):
        conversation_id = str(
            uuid.uuid4()
        )

        with self.lock:
            self.conversations[
                str(user_id)
            ][conversation_id] = {
                "conversation_id":
                    conversation_id,
                "user_id":
                    str(user_id),
                "messages":
                    [],
                "current_document":
                    None,
                "current_documents":
                    [],
                "current_topic":
                    None,
                "last_question":
                    None,
                "last_rewritten_question":
                    None,
                "last_answer":
                    None,
                "last_sources":
                    [],
            }

        logger.info(
            "Created conversation: %s | user=%s",
            conversation_id,
            user_id
        )
        return conversation_id

    # ========================================================
    # GET CONVERSATION
    # ========================================================
    def get_conversation(
        self,
        user_id,
        conversation_id
    ):
        if not conversation_id:
            return None

        user_id = str(user_id)

        with self.lock:
            conversation = (
                self.conversations
                .get(user_id, {})
                .get(conversation_id)
            )

            if not conversation:
                return None
            return conversation.copy()

    # ========================================================
    # GET OR CREATE
    # ========================================================
    def get_or_create_conversation(
        self,
        user_id,
        conversation_id=None
    ):
        # ----------------------------------------------------
        # Existing conversation requested
        # ----------------------------------------------------
        if conversation_id:
            conversation = (
                self.get_conversation(
                    user_id,
                    conversation_id
                )
            )

            if conversation:
                return (
                    conversation_id,
                    conversation
                )

            logger.warning(
                "Conversation not found or does not "
                "belong to user. Creating new conversation. "
                "conversation=%s | user=%s",
                conversation_id,
                user_id
            )

        # ----------------------------------------------------
        # Create new conversation
        # ----------------------------------------------------
        new_conversation_id = (
            self.create_conversation(
                user_id
            )
        )

        conversation = (
            self.get_conversation(
                user_id,
                new_conversation_id
            )
        )

        return (
            new_conversation_id,
            conversation
        )

    # ========================================================
    # ADD MESSAGE
    # ========================================================
    def add_message(
        self,
        user_id,
        conversation_id,
        question,
        answer,
        rewritten_question=None,
        sources=None,
    ):
        user_id = str(user_id)

        with self.lock:
            conversation = (
                self.conversations
                .get(user_id, {})
                .get(conversation_id)
            )

            if not conversation:
                logger.warning(
                    "Cannot add message. "
                    "Conversation not found. "
                    "conversation=%s | user=%s",
                    conversation_id,
                    user_id
                )
                return False

            # ------------------------------------------------
            # Determine documents used by this answer
            # ------------------------------------------------
            document_names = []

            if sources:
                for source in sources:
                    filename = source.get(
                        "filename"
                    )

                    if (
                        filename
                        and filename
                        not in document_names
                    ):
                        document_names.append(
                            filename
                        )

            # ------------------------------------------------
            # Store message
            # ------------------------------------------------
            message = {
                "question":
                    question,
                "rewritten_question":
                    rewritten_question,
                "answer":
                    answer,
                "documents":
                    document_names,
                "sources":
                    sources or [],
            }

            conversation[
                "messages"
            ].append(
                message
            )

            # ------------------------------------------------
            # Keep latest conversation state
            # ------------------------------------------------
            conversation[
                "last_question"
            ] = question

            conversation[
                "last_rewritten_question"
            ] = (
                rewritten_question
                or question
            )

            conversation[
                "last_answer"
            ] = answer

            conversation[
                "last_sources"
            ] = sources or []

            conversation[
                "current_documents"
            ] = document_names

            if document_names:
                conversation[
                    "current_document"
                ] = document_names[0]

            logger.info(
                "Conversation message stored | "
                "conversation=%s | question=%s | "
                "documents=%s",
                conversation_id,
                question,
                document_names
            )
            return True

    # ========================================================
    # GET RECENT MESSAGES
    # ========================================================
    def get_recent_messages(
        self,
        user_id,
        conversation_id,
        limit=5
    ):
        conversation = (
            self.get_conversation(
                user_id,
                conversation_id
            )
        )

        if not conversation:
            return []

        messages = conversation.get(
            "messages",
            []
        )
        return messages[-limit:]

    # ========================================================
    # GET LAST MESSAGE
    # ========================================================
    def get_last_message(
        self,
        user_id,
        conversation_id
    ):
        conversation = (
            self.get_conversation(
                user_id,
                conversation_id
            )
        )

        if not conversation:
            return None

        messages = conversation.get(
            "messages",
            []
        )

        if not messages:
            return None

        return messages[-1]

    # ========================================================
    # GET CONTEXT
    # ========================================================
    def get_context(
        self,
        user_id,
        conversation_id,
        message_limit=5
    ):
        conversation = (
            self.get_conversation(
                user_id,
                conversation_id
            )
        )

        if not conversation:
            return {
                "conversation_id":
                    conversation_id,
                "current_document":
                    None,
                "current_documents":
                    [],
                "current_topic":
                    None,
                "last_question":
                    None,
                "last_rewritten_question":
                    None,
                "last_answer":
                    None,
                "messages":
                    [],
            }

        messages = conversation.get(
            "messages",
            []
        )

        return {
            "conversation_id":
                conversation.get(
                    "conversation_id"
                ),
            "current_document":
                conversation.get(
                    "current_document"
                ),
            "current_documents":
                conversation.get(
                    "current_documents",
                    []
                ),
            "current_topic":
                conversation.get(
                    "current_topic"
                ),
            "last_question":
                conversation.get(
                    "last_question"
                ),
            "last_rewritten_question":
                conversation.get(
                    "last_rewritten_question"
                ),
            "last_answer":
                conversation.get(
                    "last_answer"
                ),
            "messages":
                messages[-message_limit:],
        }

    # ========================================================
    # UPDATE TOPIC
    # ========================================================
    def update_topic(
        self,
        user_id,
        conversation_id,
        topic
    ):
        if not topic:
            return False

        user_id = str(user_id)

        with self.lock:
            conversation = (
                self.conversations
                .get(user_id, {})
                .get(conversation_id)
            )

            if not conversation:
                return False

            conversation[
                "current_topic"
            ] = topic

            logger.info(
                "Conversation topic updated | "
                "conversation=%s | topic=%s",
                conversation_id,
                topic
            )

            return True

    # ========================================================
    # CLEAR CONVERSATION
    # ========================================================
    def clear_conversation(
        self,
        user_id,
        conversation_id
    ):
        user_id = str(user_id)

        with self.lock:
            user_conversations = (
                self.conversations.get(
                    user_id
                )
            )

            if not user_conversations:
                return False

            if (
                conversation_id
                not in user_conversations
            ):
                return False

            del user_conversations[
                conversation_id
            ]

            logger.info(
                "Conversation cleared | "
                "conversation=%s | user=%s",
                conversation_id,
                user_id
            )

            return True

# ============================================================
# GLOBAL CONVERSATION SERVICE
# ============================================================
conversation_service = (
    ConversationService()
)

