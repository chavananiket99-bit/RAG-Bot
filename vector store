import logging

from services.pdf_reader import read_pdf
from services.ocr_reader import read_scanned_pdf
from services.chunk_service import split_text

logger = logging.getLogger("uvicorn.error")

def extract_text(pdf_path):
    """
    Extract text from a PDF.
    
    Processing flow:
        Text PDF
            ↓
        Page extraction
            ↓
        If no usable text
            ↓
        OCR fallback
            ↓
        Page-aware chunks
    
    Returns:
        {
            "text": str,
            "pages": list[dict],
            "chunks": list[dict],
            "ocr_used": bool
        }
    """

    logger.info(
        "Extracting text from PDF: %s",
        pdf_path
    )

    # ============================================================
    # STEP 1 — NORMAL TEXT EXTRACTION
    # ============================================================
    pages = read_pdf(
        pdf_path
    )

    extracted_text = "\n".join(
        page.get("text", "")
        for page in pages
        if page.get("text")
    ).strip()

    # ============================================================
    # STEP 2 — OCR FALLBACK
    # ============================================================
    ocr_used = False

    if not extracted_text:
        logger.info(
            "No extractable text found. Performing OCR..."
        )
        pages = read_scanned_pdf(
            pdf_path
        )
        ocr_used = True

    # ============================================================
    # STEP 3 — BUILD FULL TEXT
    # ============================================================
    text = "\n".join(
        page.get("text", "")
        for page in pages
        if page.get("text")
    ).strip()

    # ============================================================
    # STEP 4 — CHUNKING
    # ============================================================
    chunks = split_text(
        pages
    )

    logger.info(
        "PDF processing completed. "
        "Pages=%s | Characters=%s | Chunks=%s | OCR=%s",
        len(pages),
        len(text),
        len(chunks),
        ocr_used,
    )

    return {
        "text": text,
        "pages": pages,
        "chunks": chunks,
        "ocr_used": ocr_used,
    }

