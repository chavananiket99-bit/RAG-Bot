# ============================================================
    # HYBRID SEARCH
    # ============================================================

    def search(
        self,
        query,
        top_k=8
    ):
        """
        Hybrid retrieval:

        FAISS semantic search
        +
Lexical BM25-style search
        +
Reciprocal Rank Fusion
        """

        if not query or not query.strip():
            return []

        if self.index.ntotal == 0:
            return []

        semantic_results = (
            self._semantic_search(
                query,
                top_k=15
            )
        )

        lexical_results = (
            self._lexical_search(
                query,
                top_k=15
            )
        )

        # --------------------------------------------------------
        # Reciprocal Rank Fusion
        # --------------------------------------------------------

        fusion_scores = {}

        result_lookup = {}

        rrf_k = 60

        for rank, result in enumerate(
            semantic_results,
            start=1
        ):

            vector_id = result[
                "vector_id"
            ]

            fusion_scores.setdefault(
                vector_id,
                0.0
            )

            fusion_scores[
                vector_id
            ] += 1.0 / (
                rrf_k + rank
            )

            result_lookup[
                vector_id
            ] = result

        for rank, result in enumerate(
            lexical_results,
            start=1
        ):

            vector_id = result[
                "vector_id"
            ]

            fusion_scores.setdefault(
                vector_id,
                0.0
            )

            fusion_scores[
                vector_id
            ] += 1.0 / (
                rrf_k + rank
            )

            result_lookup[
                vector_id
            ] = result

        ranked_results = []

        for vector_id, fusion_score in (
            fusion_scores.items()
        ):

            result = dict(
                result_lookup[
                    vector_id
                ]
            )

            result[
                "semantic_score"
            ] = result.get(
                "score",
                0.0
            )

            result[
                "fusion_score"
            ] = float(
                fusion_score
            )

            ranked_results.append(
                result
            )

        # --------------------------------------------------------
        # Query-aware boosting
        # --------------------------------------------------------
        for result in ranked_results:
            document_score = (
                self._document_hint_score(
                    query,
                    result["filename"]
                )
            )
            intent_score = (
                self._intent_score(
                    query,
                    result["text"]
                )
            )
            signature_score = calculate_signature_score(
                result["text"]
            )
            result["document_score"] = (
                document_score
            )
            result["intent_score"] = (
                intent_score
            )
            result["signature_score"] = (
                signature_score
            )
            # Strong document-level boost.
            #
            # Example:
            # "AD Outbound agreement"
            # should strongly prefer
            # "AD Outbound.pdf".
            #
            result["final_score"] = (
                result["fusion_score"]
                + (
                    document_score
                    * 0.05
                )
                + (
                    intent_score
                    * 0.02
                )
                + (
                    signature_score
                    * 0.03
                )
            )
        ranked_results.sort(
            key=lambda x:
                x["final_score"],
            reverse=True
        )
        final_results = (
            ranked_results[:top_k]
        )

        logger.info(
            "Hybrid search: semantic=%s lexical=%s final=%s",
            len(semantic_results),
            len(lexical_results),
            len(final_results)
        )
        for rank, result in enumerate(
            final_results,
            start=1
        ):
            logger.info(
                "RANK=%s FILE=%s CHUNK=%s "
                "FINAL=%.6f FUSION=%.6f "
                "DOC=%.3f INTENT=%.3f SIGNATURE=%.3f",
                rank,
                result["filename"],
                result["chunk_index"],
                result["final_score"],
                result["fusion_score"],
                result["document_score"],
                result["intent_score"],
                result["signature_score"],
            )
            
        return final_results
