@app.post("/ask")
async def ask_question(
    request: QuestionRequest,
    current_user: dict = Depends(
        get_current_user
    ),
):

    question = request.question.strip()

    logger.info(
        "Received question: %s",
        question
    )

    if not question:

        return {
            "question": question,
            "answer":
                "Please enter a question.",
            "sources": [],
        }

    # ============================================================
    # DETECT QUESTION TYPE
    # ============================================================

    normalized_question = (
        question.lower()
    )

    signature_keywords = [

        "signatory",
        "signatories",
        "signature",
        "signatures",
        "signed",
        "signed by",
        "who signed",

        "authorized signatory",
        "authorised signatory",

        "esign",
        "e sign",
    ]

    is_signature_question = any(
        keyword
        in normalized_question
        for keyword
        in signature_keywords
    )

    # ============================================================
    # RETRIEVE
    #
    # We request more results for signature questions because
    # the actual signature block may be several chunks away.
    # ============================================================

    retrieval_k = (
        8
        if is_signature_question
        else 5
    )

    results = vector_store.search(
        query=question,
        top_k=retrieval_k,
        user_id=current_user["id"],
    )

    # ============================================================
    # SIGNATURE RESULTS
    #
    # vector_store already performs signature-aware ranking.
    # We only perform a conservative final ordering here.
    # ============================================================

    if is_signature_question:

        signature_results = [
            result
            for result in results
            if result.get(
                "signature_score",
                0.0
            ) > 0
        ]

        if signature_results:

            other_results = [
                result
                for result in results
                if result not in signature_results
            ]

            signature_results.sort(
                key=lambda result: (
                    result.get(
                        "signature_score",
                        0.0
                    ),
                    result.get(
                        "final_score",
                        0.0
                    ),
                ),
                reverse=True
            )

            results = (
                signature_results
                + other_results
            )

            results = results[:4]

            logger.info(
                "Signature-aware result selection: %s",
                len(results)
            )

    # ============================================================
    # NO RESULTS
    # ============================================================

    if not results:

        return {

            "question":
                question,

            "answer":
                "Please upload PDF first.",

            "sources":
                [],
        }

    # ============================================================
    # LOG RETRIEVED RESULTS
    # ============================================================

    logger.info(
        "Retrieved %s relevant chunks for: %s",
        len(results),
        question
    )

    for rank, result in enumerate(
        results,
        start=1
    ):

        logger.info(
            "ASK RESULT %s | FILE=%s | PAGE=%s | "
            "CHUNK=%s | FINAL=%.4f | "
            "RELEVANCE=%.4f | SIGNATURE=%.4f | "
            "FINANCIAL=%.4f",
            rank,
            result.get(
                "filename"
            ),
            result.get(
                "page_number"
            ),
            result.get(
                "chunk_index"
            ),
            result.get(
                "final_score",
                0.0
            ),
            result.get(
                "relevance_score",
                0.0
            ),
            result.get(
                "signature_score",
                0.0
            ),
            result.get(
                "financial_score",
                0.0
            ),
        )

    # ============================================================
    # BUILD GEMINI CONTEXT
    # ============================================================

    context_parts = []

    for result in results:

        context_parts.append(
            f"""
DOCUMENT:
{result.get("filename", "")}

PAGE:
{result.get("page_number", "Not specified")}

CHUNK:
{result.get("chunk_index", "Not specified")}

RETRIEVAL RELEVANCE:
{result.get("relevance_score", 0.0):.3f}

SEMANTIC SCORE:
{result.get("semantic_score", 0.0):.3f}

LEXICAL SCORE:
{result.get("lexical_score", 0.0):.3f}

SIGNATURE RELEVANCE:
{result.get("signature_score", 0.0):.3f}

FINANCIAL RELEVANCE:
{result.get("financial_score", 0.0):.3f}

CONTENT:
{result.get("text", "")}
"""
        )

    context = (
        "\n\n====================\n\n"
        .join(context_parts)
    )

    # ============================================================
    # GEMINI
    # ============================================================

    answer = ask_gemini(
        context,
        question
    )

    # ============================================================
    # SOURCES
    # ============================================================

    sources = []

    for result in results:

        sources.append(
            {
                "document_id":
                    result.get(
                        "document_id"
                    ),

                "filename":
                    result.get(
                        "filename"
                    ),

                "page_number":
                    result.get(
                        "page_number"
                    ),

                "chunk_index":
                    result.get(
                        "chunk_index"
                    ),

                "text":
                    result.get(
                        "text",
                        ""
                    ),

                "score":
                    result.get(
                        "final_score",
                        0.0
                    ),

                "relevance_score":
                    result.get(
                        "relevance_score",
                        0.0
                    ),

                "semantic_score":
                    result.get(
                        "semantic_score",
                        0.0
                    ),

                "lexical_score":
                    result.get(
                        "lexical_score",
                        0.0
                    ),

                "signature_score":
                    result.get(
                        "signature_score",
                        0.0
                    ),

                "financial_score":
                    result.get(
                        "financial_score",
                        0.0
                    ),
            }
        )

    # ============================================================
    # RESPONSE
    # ============================================================

    return {

        "question":
            question,

        "answer":
            answer,

        "sources":
            sources,
    }


