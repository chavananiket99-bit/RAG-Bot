from services.pdf_reader import read_pdf
from services.ocr_reader import read_scanned_pdf
from services.chunk_service import split_text

import logging

logger = logging.getLogger("uvicorn.error")

def extract_text(pdf_path):
    logger.info("Extracting text...")

    text = read_pdf(pdf_path)

    if not text.strip():
        logger.info("performing OCR...")
        text = read_scanned_pdf(pdf_path)

    chunks = split_text(text)

    return {"text": text, "chunks": chunks}

//backend / services / ocr_reader.py
import fitz
from rapidocr_onnxruntime import RapidOCR
import os
import logging

engine = RapidOCR()
logger = logging.getLogger("uvicorn.error")


def read_scanned_pdf(pdf_path):
   doc = fitz.open(pdf_path)
   # Initialize before the loop
   full_text = ""
   for page_num in range(len(doc)):
       page = doc.load_page(page_num)
       pix = page.get_pixmap(dpi=150)
       image_path = f"temp_page_{page_num}.png"
       pix.save(image_path)
       result, _ = engine(image_path)
       page_text = ""
       if result:
           for item in result:
               page_text += item[1] + " "
       logger.info("--- OCR Page %s ---", page_num + 1)
       logger.info("%s", page_text if page_text.strip() else "[No OCR text on this page]")

       full_text += page_text + "\n"
       if os.path.exists(image_path):
           os.remove(image_path)
   return full_text

