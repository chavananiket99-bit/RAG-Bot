@app.delete("/documents/{document_id}")
def delete_document(document_id: str, current_user: dict = Depends(get_current_user),):
    logger.info(
        "Delete request received for document: %s",
        document_id,
    )

    # ============================================================
    # STEP 1 — FIND DOCUMENT
    # ============================================================
    documents = document_manager.get_documents()
    user_id = current_user["id"]

    document = next(
        (
            item
            for item in documents
            if item.get("id") == document_id
            and item.get("user_id") == user_id
        ),
        None
    )

    if document is None:
        logger.warning(
            "Document not found for deletion: %s",
            user_id,
            document_id,
        )
        return {
            "success": False,
            "message": "Document not found.",
        }

    filename = document.get(
        "filename",
        ""
    )

    stored_filename = document.get(
        "stored_filename",
        filename
   )

    logger.info(
        "Deleting RAG document: %s -> %s",
        filename,
        document_id,
        user_id,
    )

    # ============================================================
    # STEP 2 — DELETE FAISS VECTORS FIRST
    # ============================================================
    try:
        faiss_deleted = vector_store.delete_document(
            document_id
        )

        logger.info(
            "FAISS vectors removed for document %s: %s",
            document_id,
            faiss_deleted,
        )

    except Exception as exc:
        logger.exception(
            "FAISS deletion failed for document %s",
            document_id
        )

        # --------------------------------------------------------
        # IMPORTANT:
        # Do NOT delete documents.json or physical PDF
        # if FAISS deletion fails.
        # --------------------------------------------------------
        raise HTTPException(
            status_code=500,
            detail=(
                "Document deletion stopped because "
                "FAISS cleanup failed."
            )
        ) from exc

    # ============================================================
    # STEP 3 — DELETE DOCUMENT METADATA
    # ============================================================
    deleted_document = document_manager.delete_document(
        document_id
    )

    if deleted_document is None:
        logger.error(
            "FAISS deletion succeeded but document metadata "
            "deletion failed for document: %s",
            document_id
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "FAISS vectors were deleted, but document "
                "metadata could not be removed."
            )
        )

    # ============================================================
    # STEP 4 — DELETE PHYSICAL PDF
    # ============================================================
    file_path = UPLOAD_FOLDER / stored_filename
    physical_file_deleted = False

    if file_path.exists():
        try:
            file_path.unlink()
            physical_file_deleted = True

            logger.info(
                "Physical PDF deleted: %s",
                file_path
            )

        except Exception as exc:
            logger.exception(
                "Could not delete physical PDF: %s",
                file_path
            )

            # ----------------------------------------------------
            # The RAG document has already been removed from
            # FAISS and metadata.
            #
            # We report the physical-file cleanup failure
            # separately.
            # ----------------------------------------------------
            return {
                "success": True,
                "message": (
                    "Document deleted from RAG successfully, "
                    "but physical PDF cleanup failed."
                ),
                "document": deleted_document,
                "faiss_vectors_deleted": faiss_deleted,
                "physical_file_deleted": False,
                "physical_file_error": str(exc),
            }
    else:
        logger.warning(
            "Physical PDF not found: %s",
            file_path
        )

    # ============================================================
    # STEP 5 — FINAL RESPONSE
    # ============================================================
    return {
        "success": True,
        "message": "Document deleted successfully.",
        "document": deleted_document,
        "faiss_vectors_deleted": faiss_deleted,
        "physical_file_deleted": physical_file_deleted,
    }

