from urllib import response

import google.generativeai as genai
import os
import json
import re
import logging

from dotenv import load_dotenv
logger = logging.getLogger(__name__)

load_dotenv()
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
genai.configure(api_key=GEMINI_API_KEY)
model = genai.GenerativeModel("gemini-3.5-flash")

def ask_gemini(context, question):
   normalized_question = question.lower()
   signature_keywords = [
       "signatory",
       "signatories",
       "signature",
       "signatures",
       "signed",
       "signed by",
       "who signed",
       "authorized signatory",
       "authorised signatory",
       "esign",
       "e sign",
   ]
   is_signature_question = any(
       keyword in normalized_question
       for keyword in signature_keywords
   )
   if is_signature_question:
       prompt = f"""
You are an enterprise document question-answering assistant.
You must answer the user's question using ONLY the supplied
document context.
The user is asking specifically about a SIGNATORY / SIGNATURE.
STRICT SIGNATORY RULES:
1. Identify a person's name as a signatory ONLY when the
  retrieved document context explicitly connects that person
  to a signature, signed section, authorized signatory section,
  electronic signature, "signed by" section, or equivalent.
2. Do NOT assume that a person's name is a signatory merely
  because the name appears somewhere in the document.
3. Do NOT infer or guess which company a person represents.
4. A person's company/organization must be stated explicitly
  in the same relevant document context.
5. Do NOT combine a person's name from one chunk with a company
  name from another unrelated chunk unless the context clearly
  establishes that relationship.
6. If the document identifies the person but does not explicitly
  identify the company they represent, report the person's name
  and say that the company association is not specified.
7. Preserve names exactly as they appear in the document.
  Do not correct spelling based on outside knowledge.
8. If multiple people are explicitly identified as signatories,
  list each person separately.
9. If the document contains different amendments or agreements,
  do not mix signatories from different agreements unless the
  context explicitly connects them to the agreement in the
  user's question.
10. If the retrieved context does not contain enough evidence
   to identify the signatory, reply exactly:
"I couldn't find that information in the uploaded document."
11. Do not use outside knowledge.
12. Do not mention FAISS, embeddings, retrieval, chunks,
   vector search, RRF, BM25, or internal implementation.
RESPONSE FORMAT FOR SIGNATORY QUESTIONS:
If explicitly supported:
"The document identifies the following signatory/signatories:
- Name: <exact name>
 Company/Organization: <company only if explicitly stated>
 Designation: <designation only if explicitly stated>"
If the company or designation is not explicitly stated,
omit it or say:
"Company/Organization: Not specified in the document."
DOCUMENT CONTEXT:
{context}
USER QUESTION:
{question}
ANSWER:
"""
   else:
       prompt = f"""
You are an enterprise document question-answering assistant.
Your task is to answer the user's question using ONLY the
information contained in the provided document context.
IMPORTANT RULES:
1. Do not use outside knowledge.
2. Do not guess or infer facts that are not supported by
  the document context.
3. If multiple documents are provided, use only the documents
  that contain information relevant to the question.
4. Ignore irrelevant document chunks.
5. If the context does not contain enough information to answer
  the question, reply exactly:
"I couldn't find that information in the uploaded document."
6. When the answer contains a number, amount, date, name,
  percentage, duration, or other specific value, preserve the
  value exactly as supported by the document.
7. Give a concise and direct answer.
8. Do not combine unrelated pieces of information merely because
  they appear in different document chunks.
9. Do not infer relationships between people, companies,
  agreements, dates, amounts, or clauses unless the document
  explicitly establishes that relationship.
10. Do not mention retrieval, embeddings, FAISS, BM25, RRF,
   chunks, or internal implementation details.
11. Every factual statement in your answer must be directly
   supported by the supplied DOCUMENT CONTEXT.
12. If the context contains conflicting values, do not choose
   one based on outside knowledge. State that the supplied
   context contains conflicting information.
13. Do not merge information from different documents unless
   the question explicitly asks for a comparison.
14. When answering a question about an amount, rate, date,
   person, designation, clause, or agreement term, use the
   exact supporting passage from the relevant document context.
DOCUMENT CONTEXT:
{context}
USER QUESTION:
{question}
ANSWER:
"""
       logger.info(
         "========== GEMINI CONTEXT DEBUG =========="
       )

       logger.info(
         "QUESTION=%s",
         question
       )
       logger.info(
         "CONTEXT=%s",
         context[:12000]
       )
       logger.info(
         "========== END GEMINI CONTEXT DEBUG =========="
       )

       logger.info(
         "========== GEMINI REQUEST =========="
       )

       logger.info(
         "GEMINI QUESTION=%s",
         question
       )

       logger.info(
         "GEMINI CONTEXT LENGTH=%s",
         len(context)
       )

       logger.info(
         "GEMINI PROMPT LENGTH=%s",
         len(prompt)
       )

       logger.info(
         "========== END GEMINI REQUEST =========="
       )

   response = model.generate_content(
       prompt
   )
   logger.info(
    "========== GEMINI RESPONSE =========="
   )
   logger.info(
    "GEMINI RESPONSE=%s",
    response.text
   )
   logger.info(
    "========== END GEMINI RESPONSE =========="
   )
   return response.text

# ============================================================
# FOLLOW-UP QUESTION REWRITER
# ============================================================
def rewrite_followup_question(
  question,
  last_question=None,
  last_answer=None,
  current_documents=None,
  explicit_document=None,
  current_document=None,
):
  """
  Rewrite a conversational follow-up into a standalone
  retrieval question.
  Gemini is used only for conversational rewriting.
  Document selection remains deterministic:
    1. explicit_document
    2. current_document
    3. current_documents[0]
  Gemini must not override an explicitly selected document.
  """
  if not question or not question.strip():
    return {
      "is_follow_up": False,
      "standalone_question":
        question or "",
      "target_document":
        explicit_document,
    }

  current_question = (
    question.strip()
  )

  previous_question = (
    last_question.strip()
    if isinstance(
      last_question,
      str,
    )
    else ""
  )

  previous_answer = (
    last_answer.strip()
    if isinstance(
      last_answer,
      str,
    )
    else ""
  )

  documents = (
    current_documents
    if isinstance(
      current_documents,
      list,
    )
    else []
  )

  # ========================================================
  # NO PREVIOUS CONTEXT
  # ========================================================
  if (
    not previous_question
    and not previous_answer
  ):
    return {
      "is_follow_up": False,
      "standalone_question":
        current_question,
      "target_document":
        explicit_document,
    }

  previous_answer_context = (
    previous_answer[:3000]
    if previous_answer
    else ""
  )

  document_list = "\n".join(
    f"- {filename}"
    for filename in documents
    if filename
  )

  if not document_list:
    document_list = (
      "- No document list available"
    )

  # ========================================================
  # DETERMINISTIC DOCUMENT
  # ========================================================
  deterministic_document = (
    explicit_document
    or current_document
  )

  if (
    not deterministic_document
    and documents
  ):
    if len(documents) == 1:
      deterministic_document = (
        documents[0]
      )

  # ========================================================
  # GEMINI PROMPT
  # ========================================================
  prompt = f"""
You are a query-rewriting component inside an enterprise
document question-answering system.
Your ONLY job is to determine whether the CURRENT USER QUESTION
is a conversational follow-up and, if necessary, rewrite it
into a standalone retrieval question.
DO NOT answer the question.
DO NOT summarize documents.
DO NOT invent facts.
DO NOT invent document names.
============================================================
PREVIOUS USER QUESTION
============================================================
{previous_question}
============================================================
PREVIOUS ANSWER
============================================================
{previous_answer_context}
============================================================
CURRENT USER QUESTION
============================================================
{current_question}
============================================================
AVAILABLE DOCUMENTS
============================================================
{document_list}
============================================================
DETERMINISTIC CURRENT DOCUMENT
============================================================
{deterministic_document or "None"}
============================================================
RULES
============================================================
1. If the current question is standalone, preserve it.
2. If it is a follow-up, resolve conversational references
  using the previous question and previous answer.
3. Examples of follow-up references include:
  - it
  - its
  - this
  - that
  - this one
  - that one
  - the other one
  - the second one
  - the first one
  - the rate
  - the amount
  - the rent
  - renewal
  - duration
4. Preserve the SUBJECT of the previous question.
Example:
Previous:
"What is the rent of the Inbound warehouse?"
Current:
"What about the outbound one?"
Rewrite:
"What is the rent of the Outbound warehouse?"
5. If the current question says:
"And the rate?"
and the previous question was:
"What is the rent of the Inbound warehouse?"
preserve the subject and document.
6. DOCUMENT PRIORITY IS DETERMINISTIC.
If the deterministic current document is:
{deterministic_document or "None"}
DO NOT replace it.
7. If a document is explicitly mentioned in the current
question, that document must take priority over the previous
active document.
8. Do not invent a filename.
9. Do not invent amounts, dates, names, companies,
designations, clauses, or other facts.
10. If the relationship cannot be safely determined, keep the
current question unchanged and set is_follow_up to false.
11. Return ONLY valid JSON.
12. Return exactly:
{{
   "is_follow_up": true,
   "standalone_question": "rewritten question"
}}
or:
{{
   "is_follow_up": false,
   "standalone_question": "current question"
}}
"""
  try:
    response = model.generate_content(
      prompt
    )

    response_text = (
      getattr(
        response,
        "text",
        "",
      )
      or ""
    ).strip()

    if not response_text:
      return {
        "is_follow_up": False,
        "standalone_question":
          current_question,
        "target_document":
          explicit_document,
      }

    response_text = re.sub(
      r"^```(?:json)?\s*",
      "",
      response_text,
      flags=re.IGNORECASE,
    )

    response_text = re.sub(
      r"\s*```$",
      "",
      response_text,
    ).strip()

    parsed = json.loads(
      response_text
    )

    is_follow_up = bool(
      parsed.get(
        "is_follow_up",
        False,
      )
    )

    standalone_question = (
      parsed.get(
        "standalone_question"
      )
    )

    if not isinstance(
      standalone_question,
      str,
    ):
      standalone_question = (
        current_question
      )

    standalone_question = (
      standalone_question.strip()
    )

    if not standalone_question:
      standalone_question = (
        current_question
      )

    # ====================================================
    # IMPORTANT:
    # GEMINI DOES NOT CONTROL DOCUMENT SELECTION
    # ====================================================
    return {
      "is_follow_up":
        is_follow_up,
      "standalone_question":
        standalone_question,
      "target_document":
        explicit_document,
    }

  except json.JSONDecodeError as exc:
    logger.warning(
      "Follow-up rewriter returned invalid JSON: %s",
      exc,
    )

  except Exception as exc:
    logger.exception(
      "Follow-up question rewriting failed: %s",
      exc,
    )

  return {
    "is_follow_up": False,
    "standalone_question":
      current_question,
    "target_document":
      explicit_document,
  }
